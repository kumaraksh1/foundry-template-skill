{
  "name": "container-apps",
  "displayName": "Azure Container Apps",
  "category": "compute",
  "description": "Serverless container hosting with auto-scaling",
  "bicep": {
    "modulePath": "modules/container-apps.bicep",
    "parameters": ["containerAppsEnvironmentName", "containerAppName", "containerRegistryLoginServer", "imageName", "managedIdentityId", "envVars"],
    "outputs": ["containerAppUrl", "containerAppsEnvironmentId"]
  },
  "environmentVariables": [],
  "dependencies": {
    "python": ["gunicorn>=22.0.0"],
    "typescript": []
  },
  "roleAssignments": [],
  "defaultConfig": {
    "cpu": "1.0",
    "memory": "2Gi",
    "minReplicas": 0,
    "maxReplicas": 10,
    "targetPort": 50505,
    "targetPortNote": "Python+Gunicorn templates typically use 50505; Node/TS may use 3000 or 8080. Match the app's Dockerfile EXPOSE port."
  }
}

{
  "name": "storage",
  "displayName": "Azure Storage Account",
  "category": "storage",
  "description": "Object storage for documents, files, queues, and tables. AI Foundry projects require containers + files + queues + tables.",
  "bicep": {
    "modulePath": "core/storage/storage-account.bicep",
    "parameters": ["storageAccountName", "containers", "files", "queues", "tables"],
    "outputs": ["storageAccountName", "storageAccountId", "primaryEndpoints"]
  },
  "environmentVariables": [
    "AZURE_STORAGE_ACCOUNT",
    "AZURE_STORAGE_BLOB_ENDPOINT"
  ],
  "dependencies": {
    "python": ["azure-storage-blob>=12.22.0", "azure-identity>=1.17.0"],
    "typescript": ["@azure/storage-blob", "@azure/identity"]
  },
  "roleAssignments": [
    {
      "role": "Storage Blob Data Contributor",
      "roleDefinitionId": "ba92f5b4-2d11-453d-a403-e96b0029c9fe"
    },
    {
      "role": "Storage Account Contributor",
      "roleDefinitionId": "17d1049b-9a84-46fb-8f53-869881c3d3ab",
      "note": "Needed when AI Services system identity manages storage"
    }
  ],
  "defaultConfig": {
    "sku": "Standard_LRS",
    "containers": ["default"],
    "files": ["default"],
    "queues": ["default"],
    "tables": ["default"],
    "note": "AI Foundry requires all four service types. For simple blob-only scenarios, omit files/queues/tables."
  }
}
